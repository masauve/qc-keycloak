# =============================================================================
# Containerfile - Red Hat Build of Keycloak 26.4 personnalisé
# Quebec
#
# Structure en deux étapes (multi-stage build) conformément à la documentation :
# https://docs.redhat.com/en/documentation/red_hat_build_of_keycloak/26.4/html-single/server_configuration_guide/index#containers-writing-your-optimized-red-hat-build-of-keycloak-containerfile
#
# Étape 1 (builder): Copie des fournisseurs personnalisés et exécution de kc.sh build
#                    pour optimiser l'image (pré-configuration, réduction du démarrage).
# Étape 2 (final):   Image minimale avec les fichiers optimisés uniquement.
# =============================================================================

# --- Étape 1 : Construction et optimisation ---
FROM registry.redhat.io/rhbk/keycloak-rhel9:26.4 AS builder

# Configuration de la base de données
ENV KC_DB=postgres

# Fonctionnalités activées
# user-event-metrics : prerequis de event-metrics-user-enabled (sinon l'option
# reste sans effet et keycloak_user_events_total n'est jamais expose).
ENV KC_FEATURES=token-exchange,admin-fine-grained-authz,user-event-metrics

# Métriques et santé
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
# Métriques d'événements utilisateur (option de BUILD) : requises par le tableau
# de bord Grafana « capacity planning ». Doit etre integree a l'image, sinon avec
# startOptimized=true Keycloak refuse de demarrer (« build time options have
# values that differ from what is persisted »).
ENV KC_EVENT_METRICS_USER_ENABLED=true

# Chemin relatif HTTP : option de BUILD. Elle doit etre integree a l'image,
# sinon avec startOptimized=true Keycloak l'ignore (« values that differ from
# what is persisted ») et sert sur « / », ce qui fait echouer les sondes de
# sante de l'operateur (attendues sur /auth) -> CrashLoopBackOff.
ENV KC_HTTP_RELATIVE_PATH=/auth

# NOTE : cache et cache-stack sont des options d'EXECUTION depuis Keycloak 26.0
# (elles ne sont plus reconnues par « kc.sh build »). Elles sont configurees
# au demarrage via l'image finale (ENV ci-dessous) et la ressource Keycloak CR.

WORKDIR /opt/keycloak

# Copier le fournisseur du thème Quebec
# (compilé par le pipeline Tekton avec Maven avant cette étape)
COPY theme/target/keycloak-theme-quebec-1.0.0.jar /opt/keycloak/providers/

# Copier le fournisseur de l'action requise (acceptation des conditions)
COPY required-action/target/keycloak-required-action-1.0.0.jar /opt/keycloak/providers/

# Exécuter la commande d'optimisation de Keycloak.
# Cette commande effectue la résolution des SPIs, la génération du bytecode optimisé
# et intègre la configuration dans l'image, réduisant le temps de démarrage.
RUN /opt/keycloak/bin/kc.sh build \
    --db=postgres \
    --health-enabled=true \
    --metrics-enabled=true \
    --event-metrics-user-enabled=true \
    --features=token-exchange,admin-fine-grained-authz,user-event-metrics \
    --http-relative-path=/auth

# --- Étape 2 : Image finale minimale ---
FROM registry.redhat.io/rhbk/keycloak-rhel9:26.4

# Copier l'intégralité du répertoire Keycloak optimisé depuis l'étape de construction
COPY --from=builder /opt/keycloak/ /opt/keycloak/

# Variables d'environnement d'exécution (non sensibles)
# Les valeurs sensibles (DB_URL, DB_USERNAME, DB_PASSWORD, KC_HOSTNAME)
# sont injectées par l'opérateur Keycloak via la ressource Keycloak CR.
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
ENV KC_CACHE=ispn
# jdbc-ping : decouverte du cluster via PostgreSQL (recommande pour l'operateur
# depuis Keycloak 26.1). Le stack « kubernetes » exigeait -Djgroups.dns.query.
ENV KC_CACHE_STACK=jdbc-ping
ENV KC_HTTP_RELATIVE_PATH=/auth

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
